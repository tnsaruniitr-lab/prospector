# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Railway Postgres connection string (required)
# Get from: railway.app → your Postgres service → Connect tab → Public URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@xxx.proxy.rlwy.net:PORT/railway

# Optional: for headless discovery fallback only (not required — browser discovery is the default)
# GOOGLE_MAPS_API_KEY=your_key_here
