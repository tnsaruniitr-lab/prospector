# Postgres on Railway.
# In Railway: New → Database → PostgreSQL, then copy the connection string.
# Use the PUBLIC url (…proxy.rlwy.net) when running this CLI from your machine;
# use the internal url if you later deploy the tool inside the same Railway project.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# Google Places API (New) — Cloud Console → enable "Places API (New)".
# Needed only for the `source` command.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Apollo contact enrichment.
# Search is used to find owner/founder/manager names + LinkedIn profile URLs.
# Email/phone reveal is off unless explicitly enabled because it can consume credits.
APOLLO_API_KEY=
APOLLO_ENRICH=false
APOLLO_REVEAL_EMAILS=false
APOLLO_REVEAL_PHONES=false

# Optional: Semrush official API enrichment.
# SEMRUSH_DATABASE can be left blank; the CSV runner infers it from country/city
# where possible (US, DE, AE, SA, TR, etc.).
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=
SEMRUSH_TOP_KEYWORDS_LIMIT=8
SEMRUSH_COMPETITORS_LIMIT=5

# Optional: path to the deterministic auditor script.
# Defaults to ../aeo-seo-auditor/skill-unified/scripts/run_deterministic.sh
# AUDITOR_SCRIPT=/abs/path/to/run_deterministic.sh

# Optional: batch-audit tuning.
AUDIT_CONCURRENCY=4
AUDIT_TIMEOUT_MS=90000

# Optional: LLM-sharpened openers (deterministic templates used if absent).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
