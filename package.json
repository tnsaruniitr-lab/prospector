{
  "name": "prospect-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Audit-led outbound: discover local-service businesses by ICP+geo, deep-research each (rendered AEO/SEO audit + SEMrush AI visibility + LinkedIn founder), rank, and emit a structured outreach worklist. Browser-first, no data API keys.",
  "license": "MIT",
  "bin": {
    "prospect-engine": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "public",
    "migrations",
    ".claude",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:local": "tsx src/start-local.ts",
    "connect": "tsx src/agent.ts",
    "queue": "tsx src/queue.ts",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "migrate": "tsx src/migrate.ts",
    "source": "tsx src/cli.ts source",
    "audit": "tsx src/cli.ts audit",
    "enrich": "tsx src/cli.ts enrich",
    "worklist": "tsx src/cli.ts worklist",
    "pipeline": "tsx src/cli.ts pipeline",
    "csv": "tsx src/cli.ts csv",
    "dossier:csv": "tsx src/cli.ts dossier-csv",
    "db:export": "tsx src/cli.ts db-export",
    "db:flow": "tsx src/db-flow.ts",
    "grade": "tsx src/grade-all.ts",
    "relevance": "tsx src/relevance-worklist.ts",
    "playbooks": "tsx src/cli.ts playbooks",
    "dev": "tsx watch src/cli.ts",
    "build": "tsc"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0"
  }
}
